{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mock": "vite build --mode mock",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "format": "prettier --write src e2e docs scripts .github src-tauri README.md \"*.{json,yaml,yml,html,ts,mts,cts,js,mjs,cjs,css}\"",
    "format:check": "prettier --check src e2e docs scripts .github src-tauri README.md \"*.{json,yaml,yml,html,ts,mts,cts,js,mjs,cjs,css}\"",
    "test": "vitest run",
    "e2e:mock": "vite build --mode mock && playwright test --project mock",
    "e2e:app": "tauri build --debug --no-bundle && playwright test --project app",
    "budgets": "node scripts/check-budgets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
